{
  "name": "mcp-movidesk",
  "version": "1.0.0",
  "description": "MCP server para interação com a API do Movidesk via linguagem natural",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-movidesk": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "prepare": "npm run build",
    "hooks:install": "husky",
    "precommit:build": "npm run build && git add dist",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "@types/express": "^5.0.0",
    "@types/node": "^26.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
